rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin checking function
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('.*@mnfr\\.in$') || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // Retailer checking function
    function isRetailer(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Orders Collection
    match /orders/{orderId} {
      // Retailers can read their own orders and create new ones assigned to themselves
      allow read: if isAdmin() || (resource != null && resource.data.retailerId == request.auth.uid);
      allow create: if isAdmin() || (request.resource.data.retailerId == request.auth.uid);
      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, update: if isAdmin() || (resource != null && resource.data.userId == request.auth.uid);
      allow create, delete: if isAdmin();
    }

    // Settings Collection
    match /system/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Retailers Collection
    match /retailers/{userId} {
      allow read: if isAdmin() || isRetailer(userId);
      allow create: if isRetailer(userId);
      allow update: if isAdmin() || (isRetailer(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Inventory Collection
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media Library Collection
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
