rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@mnfr\\.in$') ||
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email == 'mananjain0410@gmail.com' ||
          request.auth.token.email == 'admin@wholesale.com' ||
          request.auth.token.email == 'admin@portal.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/retailers/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/retailers/$(request.auth.uid)).data.get('role', 'retailer') == 'admin')
      );
    }

    function isRetailer(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products Collection - Public Read, Admin Write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories Collection - Public Read, Admin Write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // System Settings & Business Profile - Public Read, Admin Write
    match /system/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Inventory Collection - Public Read, Admin Write
    match /inventory/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Colors - Public Read, Admin Write
    match /master_colors/{colorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Fabrics - Public Read, Admin Write
    match /master_fabrics/{fabricId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Fits - Public Read, Admin Write
    match /master_fits/{fitId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Lengths - Public Read, Admin Write
    match /master_lengths/{lengthId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Master Sizes - Public Read, Admin Write
    match /master_sizes/{sizeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Media Library Collection - Public Read, Admin Write
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Retailers Collection - Retailers can read/write their own profile; admins can manage all
    match /retailers/{userId} {
      allow get: if isAdmin() || isRetailer(userId);
      allow list: if isAdmin();
      allow create: if isRetailer(userId) || isAdmin();
      allow update: if isAdmin() || (
        isRetailer(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role']))
      );
      allow delete: if isAdmin();
    }

    // Orders Collection - Retailers manage their own orders; admins manage all orders
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.retailerId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.retailerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Saved Carts & Wishlists Collection - Retailers manage their own saved carts
    match /savedCarts/{cartId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.retailerId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.retailerId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.retailerId == request.auth.uid && 
        request.resource.data.retailerId == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.retailerId == request.auth.uid);
    }

    // Notifications Collection - User specific notifications
    match /notifications/{notificationId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Audit Logs Collection - Admin Only
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admins Collection - Admin Only
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
